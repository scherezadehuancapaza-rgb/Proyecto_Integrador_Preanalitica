# Configuración de Flask
# Genera una clave larga y segura para tu entorno local
FLASK_SECRET_KEY=tu_clave_secreta_aqui

# Configuración SMTP (Correo)
# Si no tienes credenciales, deja los campos vacíos (modo prueba)
SMTP_SERVIDOR=smtp.ejemplo.com
SMTP_PUERTO=587
SMTP_USUARIO=tu_correo@ejemplo.com
SMTP_CLAVE=tu_contrasena
CORREOS_DESTINO=jefatura@ejemplo.com